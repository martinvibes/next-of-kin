# ── Tatum (server-side only; never exposed to the browser) ──────────────
# Create a free key at https://dashboard.tatum.io
TATUM_API_KEY=

# ── Walrus Memory (MAINNET) ─────────────────────────────────────────────
# Create at https://memory.walrus.xyz → you get an account ID + delegate private key
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_NAMESPACE=next-of-kin
# Optional; defaults to the Mainnet relayer
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ── Owner auth (single owner per deployment) ────────────────────────────
# Any long random string. You type it once in the UI to unlock writes.
OWNER_SECRET=

# ── Wallets to watch (comma-separated, optional — you can also add them in the UI)
NOK_SUI_ADDRESSES=
NOK_ETH_ADDRESS=

# ── Dev only: fixed fake chain data for UI work. NEVER set in production.
NOK_FIXTURES=0
